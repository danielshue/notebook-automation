<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <!-- MSTest configuration -->
    <MSTest>
        <!-- Force sequential execution by setting workers to 1 -->
        <ParallelizeWorkers>false</ParallelizeWorkers>
        <ParallelizeAssembly>false</ParallelizeAssembly>
        <ExecutionThreadApartmentState>STA</ExecutionThreadApartmentState>
    </MSTest>

    <!-- Test execution timeout -->
    <RunConfiguration>
        <TestSessionTimeout>300000</TestSessionTimeout> <!-- 5 minutes -->
        <MaxCpuCount>1</MaxCpuCount> <!-- Force single CPU usage -->
    </RunConfiguration>

    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat code coverage">
                <Configuration>
                    <!-- Use only cobertura format - opencover doesn't support DeterministicReport -->
                    <Format>cobertura</Format>
                    <!-- Include both Core and CLI assemblies -->
                    <Include>[NotebookAutomation.Core]*,[na]*,[NotebookAutomation.Cli]*</Include>
                    <!-- Exclude generated regex and migration files -->
                    <Exclude>[*]System.Text.RegularExpressions.Generated*</Exclude>
                    <ExcludeByFile>**/Migrations/**/*.cs</ExcludeByFile>
                    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
                    <SingleHit>true</SingleHit>
                    <UseSourceLink>true</UseSourceLink>
                    <DeterministicReport>true</DeterministicReport>
                    <SkipAutoProps>true</SkipAutoProps>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>